// Identity events near the endpoint investigation window
let StartTime = datetime(2026-09-20T09:00:00Z);
let EndTime = datetime(2026-09-20T11:00:00Z);
let InvestigatedUser = "user1@example.invalid";
AADSignInEventsBeta
| where Timestamp between (StartTime .. EndTime)
| where AccountUpn =~ InvestigatedUser
| project Timestamp, AccountUpn, IPAddress, Country, Application,
          LogonType, ErrorCode
| order by Timestamp asc;

// Failed sign-in activity by account
AADSignInEventsBeta
| where Timestamp > ago(24h)
| where ErrorCode != 0
| summarize Failures=count(), SourceIPs=make_set(IPAddress, 20) by AccountUpn
| where Failures >= 5
| order by Failures desc;
